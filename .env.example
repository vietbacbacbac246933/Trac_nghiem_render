# ---------------------------------------------------------------------------
# Mau bien moi truong. Sao chep thanh .env khi chay local (KHONG commit .env).
# Tren Render: khai bao trong Dashboard > Environment (hoac render.yaml).
# ---------------------------------------------------------------------------

# Cong server lang nghe. Local mac dinh 3456. Render tu cap -> KHONG dat tay.
PORT=3456

# Mat khau de dang nhap trang giao vien (/teacher).
# Neu de trong: trang giao vien chi truy cap duoc tu localhost (che do LAN cu).
TEACHER_PASSWORD=doi-mat-khau-nay-that-manh

# Khoa ky cookie phien giao vien (chuoi ngau nhien dai).
# Neu bo trong, he thong tu dan xuat tu TEACHER_PASSWORD (khuyen nghi dat rieng).
SESSION_SECRET=

# Chuoi ket noi PostgreSQL. Neu bo trong -> dung luu tru bang file (nhu ban LAN).
# Vi du Render: postgresql://user:pass@host:5432/dbname
# Bat buoc them ?sslmode=require neu ket noi DB quan ly o ngoai Render.
DATABASE_URL=

# So ket noi toi da trong pool PostgreSQL (mac dinh 5).
PG_POOL_MAX=5

# production / development
NODE_ENV=production

# ---------------------------------------------------------------------------
# OCR - doc chu tu anh de nhap de thi (khong bat buoc)
# ---------------------------------------------------------------------------
# auto (mac dinh) | tesseract | ocrspace
#   auto: co OCR_SPACE_API_KEY thi dung ocrspace, nguoc lai dung tesseract.
#   tesseract: chay ngay trong Node (WASM), mien phi, khong can API key.
OCR_PROVIDER=auto

# Ngon ngu OCR, cach nhau bang dau phay hoac dau +. Mac dinh vie+eng.
OCR_LANGS=vie+eng

# Khoa OCR.space (chi can khi muon dung OCR_PROVIDER=ocrspace).
# Lay tai https://ocr.space/ocrapi (co goi mien phi). KHONG commit khoa that.
OCR_SPACE_API_KEY=

# Dat =1 de in tien trinh OCR ra console khi can go loi.
OCR_DEBUG=
